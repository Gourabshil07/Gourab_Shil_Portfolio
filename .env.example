# App host URL (auto-populated on Cloud Run)
APP_URL=http://localhost:3000

# Target contact email where messages are delivered
CONTACT_EMAIL=your-email@gmail.com

# OPTION 1: Gmail / SMTP (Standard)
# If using Gmail, generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Or GMAIL_APP_PASSWORD=

# OPTION 2: Resend API (Transactional Email Service)
# RESEND_API_KEY=
# RESEND_FROM="Gourab Portfolio <onboarding@resend.dev>"

# OPTION 3: Google Cloud OAuth2
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

